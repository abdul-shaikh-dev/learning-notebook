          "body",
          "Body text",
          "777777",
          "ffffff",
          "ordinary text"
         ]
        ]
       }
      ]
     },
     {
      "title": "One step darker",
      "focus": [
       "body"
      ],
      "explanation": "#767676 measures 4.54:1 and passes. The smallest change that passes is still a change worth measuring, not guessing.",
      "nodes": [
       {
        "id": "verdict",
        "label": "Verdict",
        "detail": "Passes, with almost no margin",
        "tone": "active",
        "x": 30,
        "y": 40
