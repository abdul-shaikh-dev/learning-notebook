        "label": "Choose on validation",
        "steps": [
          {
            "title": "Threshold 0.5",
            "explanation": "At 0.5, V1 and V2 are flagged. V1 needs help (a true positive) and V2 is fine (a false positive). V3 needs help but is missed (a false negative). Cost = 4 × 1 + 1 = 5.",
