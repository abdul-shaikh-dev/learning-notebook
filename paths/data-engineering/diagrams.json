      },
      {
        "id": "load",
        "label": "Load",
        "description": "Commit target transaction."
      },
      {
        "id": "reconcile",
        "label": "Reconcile",
        "description": "Compare keys/counts/totals."
      },
      {
        "id": "publish",
        "label": "Publish",
        "description": "Expose accepted output."
      }
