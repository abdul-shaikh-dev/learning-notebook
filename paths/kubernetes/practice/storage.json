{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "lab-data",
        "namespace": "notebook-lab"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "256Mi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "storage-demo",
        "namespace": "notebook-lab"
      },
      "spec": {
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10001,
          "runAsGroup": 10001,
          "seccompProfile": {
            "type": "RuntimeDefault"
          },
          "fsGroup": 10001
        },
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "writer",
            "image": "notebook-release:v1",
            "imagePullPolicy": "Never",
            "command": [
              "python",
              "-c",
              "from pathlib import Path; import time; p=Path('/data/message'); p.write_text('retained synthetic data') if not p.exists() else None; print(p.read_text(),flush=True); time.sleep(3600)"
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "64Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "128Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "data",
                "mountPath": "/data"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "data",
            "persistentVolumeClaim": {
              "claimName": "lab-data"
            }
          }
        ]
      }
    }
  ]
}
