{
  "apiVersion": "autoscaling/v2",
  "kind": "HorizontalPodAutoscaler",
  "metadata": {
    "name": "release-demo",
    "namespace": "notebook-lab"
  },
  "spec": {
    "scaleTargetRef": {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "name": "release-demo"
    },
    "minReplicas": 2,
    "maxReplicas": 4,
    "metrics": [
      {
        "type": "Resource",
        "resource": {
          "name": "cpu",
          "target": {
            "type": "Utilization",
            "averageUtilization": 60
          }
        }
      }
    ],
    "behavior": {
      "scaleDown": {
        "stabilizationWindowSeconds": 120
      }
    }
  }
}
