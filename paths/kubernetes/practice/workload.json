{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "workload",
        "namespace": "notebook-lab"
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "release-config",
        "namespace": "notebook-lab"
      },
      "data": {
        "RELEASE_VERSION": "v1"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "release-demo",
        "namespace": "notebook-lab"
      },
      "spec": {
        "replicas": 2,
        "revisionHistoryLimit": 3,
        "progressDeadlineSeconds": 120,
        "selector": {
          "matchLabels": {
            "app": "release-demo"
          }
        },
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxSurge": 1,
            "maxUnavailable": 0
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "release-demo"
            }
          },
          "spec": {
            "serviceAccountName": "workload",
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "terminationGracePeriodSeconds": 30,
            "containers": [
              {
                "name": "app",
                "image": "notebook-release:v1",
                "imagePullPolicy": "Never",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "release-config"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "RELEASE_DB",
                    "value": "/tmp/notes.db"
                  },
                  {
                    "name": "NOT_READY_FILE",
                    "value": "/tmp/not-ready"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "scratch",
                    "mountPath": "/tmp"
                  }
                ],
                "startupProbe": {
                  "httpGet": {
                    "path": "/live",
                    "port": "http"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 2,
                  "failureThreshold": 12
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/live",
                    "port": "http"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 2,
                  "failureThreshold": 3
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": "http"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 2,
                  "failureThreshold": 3
                }
              }
            ],
            "volumes": [
              {
                "name": "scratch",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "release-demo",
        "namespace": "notebook-lab"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app": "release-demo"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": "http"
          }
        ]
      }
    }
  ]
}
