              {
                "id": "obs",
                "label": "Observations",
                "detail": "10, 10, 10, 10 ms · n = 4",
                "x": 40,
                "y": 50,
                "tone": "neutral"
              },
              {
                "id": "mean",
                "label": "Mean",
                "detail": "40 / 4 = 10 ms",
                "x": 390,
                "y": 50,
                "tone": "neutral"
              },
              {
                "id": "median",
                "label": "Median",
                "detail": "Middle of 4 sorted values: 10 ms",
                "x": 740,
                "y": 50,
                "tone": "neutral"
              }
            ],
            "edges": [
              {
                "from": "obs",
                "to": "mean",
                "label": "sum ÷ count"
              },
